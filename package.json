{
  "name": "go-gas-executive-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx \"Analytical Dashboard/server.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx \"Analytical Dashboard/server.ts\"",
    "postinstall": "patch-package",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'server.js'].forEach(p => fs.rmSync(p, { recursive: true, force: true }));\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"Analytical Dashboard/src/engine/*.test.ts\"",
    "load-sales": "tsx \"Manual Work/load_sales.ts\"",
    "load-station-mapping": "tsx \"Manual Work/load_station_contact_mapping.ts\"",
    "test-db": "tsx test_db.ts",
    "email:send": "tsx \"Analytical Dashboard/send_morning_report.ts\"",
    "service:prod": "npm run build && node -e \"const { spawn } = require('child_process'); spawn('npx', ['tsx', 'Analytical Dashboard/server.ts'], { stdio: 'inherit', shell: true, env: { ...process.env, NODE_ENV: 'production' } }).on('exit', c => process.exit(c || 0))\"",
    "service:pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "service:pm2:stop": "pm2 stop go-gas-executive-suite",
    "service:pm2:logs": "pm2 logs go-gas-executive-suite"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.0",
    "whatsapp-web.js": "1.34.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
