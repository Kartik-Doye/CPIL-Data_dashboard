# Gmail SMTP account and fixed report recipients
REPORT_SENDER_EMAIL= cpilkartikdoye@gmail.com
REPORT_RECIPIENT_EMAILS= doyekartik03@gmail.com
REPORT_SENDER_APP_PASSWORD= 

# WhatsApp Automated Dispatch Configuration
WHATSAPP_ENABLED=true
# Comma-separated WhatsApp recipient numbers with country code
WHATSAPP_RECIPIENT_NUMBERS=
# Optional Chrome/Chromium executable path if Puppeteer cannot find a browser
WHATSAPP_CHROME_EXECUTABLE_PATH=
# Optional external gateway (leave blank to use WhatsApp Web)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
