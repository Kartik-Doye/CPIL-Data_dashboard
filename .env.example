# Application settings; blank values usually use product-config.json defaults.
APP_NAME=
APP_BASE_URL=
APP_TIMEZONE=
APP_REQUEST_BODY_LIMIT=
PORT=
FLASK_PORT=
DISABLE_HMR=

# Database connection overrides
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
BOT_READER_PASSWORD=
BOT_LOADER_USER=
BOT_LOADER_PASSWORD=
SALE_FILE=
DB_CONNECT_TIMEOUT=
DB_CONNECT_TIMEOUT_CEILING_MS=
DB_STATEMENT_TIMEOUT_MS=
DB_POOL_MAX=
DB_LOADER_POOL_MAX=
DB_IDLE_TIMEOUT_MS=

# Executive email credentials and recipients
REPORT_SENDER_EMAIL=
REPORT_RECIPIENT_EMAILS=
REPORT_SENDER_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_TO=
SMTP_FROM_NAME=
EMAIL_CRON_EXPRESSION=
EMAIL_SCHEDULE_LABEL=
EMAIL_SEND_COOLDOWN_SECONDS=
EMAIL_API_TIMEOUT_MS=

# WhatsApp Web settings
WHATSAPP_ENABLED=true
WHATSAPP_RECIPIENT_NUMBERS=
WHATSAPP_DAILY_MESSAGE=
WHATSAPP_CHROME_EXECUTABLE_PATH=
WHATSAPP_WEB_VERSION=
WHATSAPP_AUTH_DIRECTORY=
WHATSAPP_WEB_VERSION_CACHE_DIRECTORY=
# Project-root .env controls scheduled WhatsApp sends; blank/invalid disables them.
WHATSAPP_CRON_EXPRESSION=0 11,19 * * *
WHATSAPP_SCHEDULE_LABEL=11:00 AM & 07:00 PM Daily
WHATSAPP_SEND_COOLDOWN_SECONDS=
# Optional external gateway; both settings are required to use it
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Server request/telemetry behavior
TELEMETRY_CACHE_DURATION_MS=
TELEMETRY_HISTORY_WINDOW_DAYS=
LEARNING_REFRESH_INTERVAL_MS=
